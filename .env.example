# Django Settings - PLACEHOLDERS ONLY. Copy to .env and set real values there; never commit .env or put real secrets in this file.
SECRET_KEY=replace_me_with_long_random_string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (MySQL) - use app user, not root
DB_ENGINE=django.db.backends.mysql
DB_NAME=nityadharma_db
DB_USER=nitya_user
DB_PASSWORD=replace_me
DB_HOST=localhost
DB_PORT=3306

# ---------------------------------------------------------------------------
# Email — set ONE of the options below so emails reach the mailbox (GoDaddy, VPS, Railway)
# ---------------------------------------------------------------------------
# Option 1 — Gmail (works on GoDaddy, VPS; Railway may block SMTP → use Option 2)
# Create App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Option 2 — GoDaddy SMTP (use your domain mailbox)
# EMAIL_HOST=smtpout.secureserver.net
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=you@yourdomain.com
# EMAIL_HOST_PASSWORD=your-mailbox-password
# DEFAULT_FROM_EMAIL=you@yourdomain.com

# Option 3 — Railway (SMTP often blocked): use Resend instead. Set these in Railway Variables:
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=Nitya Dharma <onboarding@resend.dev>
# (Do not set EMAIL_HOST when using Resend.)

# Production security (optional overrides)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Static & Media (optional)
# STATIC_URL=/static/
# MEDIA_URL=/media/

# Local dev example (do not use in production):
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
