# Copy to .env and fill in real values. Never commit .env to git.
# Required for production (Hostinger VPS, Railway, etc.)

# Django
SECRET_KEY=your-secret-key-min-50-chars
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SITE_URL=https://yourdomain.com

# Database (MySQL on Hostinger VPS — use DATABASE_* or DB_*)
DATABASE_NAME=nityadharma_db
DATABASE_USER=nityadharma_user
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=3306

# Alternative names (project also accepts these): DB_NAME, DB_USER, DB_PASSWORD, DB_HOST, DB_PORT

# Email (SMTP)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
SERVER_EMAIL=noreply@yourdomain.com

# Production security (VPS behind Nginx + SSL)
SECURE_SSL_REDIRECT=True

# Optional: Redis (leave unset to use in-memory cache)
# REDIS_URL=redis://127.0.0.1:6379/1

# Optional: Resend (if SMTP is blocked, e.g. some cloud platforms)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Nitya Dharma <onboarding@resend.dev>
