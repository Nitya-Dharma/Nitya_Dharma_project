# Django Settings (copy to .env and set real values; never commit .env)
SECRET_KEY=replace_me_with_long_random_string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database (MySQL) - use app user, not root
DB_ENGINE=django.db.backends.mysql
DB_NAME=nityadharma_db
DB_USER=nitya_user
DB_PASSWORD=replace_me
DB_HOST=localhost
DB_PORT=3306

# Email (e.g. Gmail App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=replace_me
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Production security (optional overrides)
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Static & Media (optional)
# STATIC_URL=/static/
# MEDIA_URL=/media/

# Local dev example (do not use in production):
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
